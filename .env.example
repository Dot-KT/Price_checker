# Copy this file to .env and fill in your local settings.
# Use plain KEY=value entries without surrounding quotes or inline comments.
# Use forward slashes in Windows paths (e.g. C:/private/service-account.json).
# If a value contains a literal backslash, write it twice: \\

DATABASE_URL=jdbc:postgresql://localhost:5432/price_checker
DATABASE_USERNAME=price_checker
DATABASE_PASSWORD=

# Optional: override the private JWT signing-key file location.
# The app creates the key on first startup and reuses it on later starts.
# JWT_SIGNING_KEY_PATH=C:/private/price-checker-jwt-signing-key.json

# Create the bot with Telegram's BotFather. Keep the token private.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_STRUCTURED_OUTPUT=true
